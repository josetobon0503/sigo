{
  "name": "sigo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.4",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.13",
    "i18next": "^26.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "export:library": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-library.ts",
    "export:videos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-video-list.ts",
    "videos:compress": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compress-videos.ts",
    "videos:test-clip": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-test-clip.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}
